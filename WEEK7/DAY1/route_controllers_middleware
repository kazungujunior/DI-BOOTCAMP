Step 4: Create a Router Module
Inside your project directory, create a new directory called routes. Inside the routes directory, create a JavaScript file (e.g., greeting.js) where you will define routes for the Emoji Greeting app using express.Router():

// routes/greeting.js
const express = require("express");
const router = express.Router();

// List of available emojis
const emojis = ["😀", "🎉", "🌟", "🎈", "👋"];

// Display the greeting form
router.get("/", (req, res) => {
  res.render("greeting-form", { emojis });
});

// Process the form submission
router.post("/greet", (req, res) => {
  const { name, emoji } = req.body;

  if (!name) {
    res.render("greeting-form", { emojis, error: "Name is required" });
  } else {
    const greeting = `Hello, ${name} ${emoji}!`;
    res.render("greeting", { greeting });
  }
});

module.exports = router;
Step 5: Create Views
Inside your project directory, create a new directory called views. Inside the views directory, create two HTML files: greeting-form.ejs and greeting.ejs. These files will be used to render the greeting form and the personalized greeting page:

<!-- views/greeting-form.ejs -->
<!DOCTYPE html>
<html>
  <head>
    <title>Emoji Greeting</title>
  </head>
  <body>
    <h1>Emoji Greeting</h1>
    <% if (error) { %>
    <p><%= error %></p>
    <% } %>
    <form action="/greet" method="POST">
      <label for="name">Your Name:</label>
      <input type="text" name="name" id="name" required />
      <label for="emoji">Choose an Emoji:</label>
      <select name="emoji" id="emoji">
        <% emojis.forEach(e => { %>
        <option value="<%= e %>"><%= e %></option>
        <% }) %>
      </select>
      <button type="submit">Generate Greeting</button>
    </form>
  </body>
</html>
<!-- views/greeting.ejs -->
<!DOCTYPE html>
<html>
  <head>
    <title>Emoji Greeting</title>
  </head>
  <body>
    <h1>Emoji Greeting</h1>
    <p><%= greeting %></p>
    <a href="/">Generate Another Greeting</a>
